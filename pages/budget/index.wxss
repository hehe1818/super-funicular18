/* pages/budget/index.wxss */

.budgetPage {
  min-height: 100vh;
  background: #F7F9F8;
  padding-bottom: env(safe-area-inset-bottom);
}

/* 预算概览头部 */
.budgetHeader {
  background: linear-gradient(135deg, #7EB8A0 0%, #5D9B85 100%);
  padding: 32rpx 24rpx 48rpx;
  border-radius: 0 0 32rpx 32rpx;
}

.monthLabel {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 24rpx;
}

.totalBudgetCard {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.2);
  padding: 32rpx;
  border-radius: 24rpx;
  backdrop-filter: blur(10px);
}

/* 环形进度图 */
.ringContainer {
  margin-right: 32rpx;
}

.ringWrapper {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.ringCanvas {
  width: 160rpx;
  height: 160rpx;
}

.ringCenter {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ringPercentage {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.ringLabel {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 总预算信息 */
.totalInfo {
  flex: 1;
}

.totalRow {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.totalRow:last-child {
  margin-bottom: 0;
}

.totalLabel {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.totalValue {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.totalUsed {
  color: #FFE4C4;
}

.totalRemaining {
  color: #C8F7C5;
}

.totalOver {
  color: #FFB3B3;
}

.totalValueRow {
  display: flex;
  align-items: center;
  transition: all 0.2s ease;
}

.totalValueRowHover {
  opacity: 0.8;
  transform: scale(1.05);
}

.editIcon {
  font-size: 24rpx;
  margin-left: 8rpx;
  opacity: 0.8;
}

/* 总进度条 */
.totalProgressBar {
  height: 16rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 8rpx;
  margin-top: 32rpx;
  overflow: hidden;
  position: relative;
}

.totalProgressFill {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.5s ease;
}

.progressWarning {
  position: absolute;
  right: -8rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 16rpx;
  height: 16rpx;
  background: #F39C12;
  border-radius: 50%;
  animation: pulse 1.5s infinite;
}

@keyframes pulse {
  0% { transform: translateY(-50%) scale(1); opacity: 1; }
  50% { transform: translateY(-50%) scale(1.2); opacity: 0.7; }
  100% { transform: translateY(-50%) scale(1); opacity: 1; }
}

/* 预警提示 */
.budgetAlert {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  margin-top: 24rpx;
  border-radius: 12rpx;
}

.alertOver {
  background: rgba(234, 32, 39, 0.2);
  border: 1rpx solid rgba(234, 32, 39, 0.3);
}

.alertWarning {
  background: rgba(243, 156, 18, 0.2);
  border: 1rpx solid rgba(243, 156, 18, 0.3);
}

.alertIcon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.alertText {
  font-size: 26rpx;
  color: #FFFFFF;
  font-weight: 500;
}

/* 分类预算区域 */
.sectionHeader {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 24rpx 16rpx;
}

.sectionTitle {
  font-size: 30rpx;
  font-weight: 600;
  color: #1D2129;
}

.sectionActions {
  display: flex;
}

.addCategoryBtn {
  padding: 12rpx 24rpx;
  background: #E8F3EE;
  color: #7EB8A0;
  font-size: 26rpx;
  border-radius: 24rpx;
  transition: all 0.2s ease;
}

.addCategoryBtnHover {
  background: #D4E8DC;
  transform: scale(0.95);
}

/* 分类列表 */
.categoryList {
  padding: 0 24rpx;
}

.categoryCard {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s ease;
}

.categoryOver {
  border-left: 6rpx solid #EA2027;
  background: #FFF5F5;
}

.categoryWarning {
  border-left: 6rpx solid #F39C12;
  background: #FFFBF0;
}

.categoryHeader {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.categoryLeft {
  display: flex;
  align-items: center;
}

.categoryIconWrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.categoryIcon {
  font-size: 36rpx;
}

.categoryInfo {
  display: flex;
  flex-direction: column;
}

.categoryName {
  font-size: 30rpx;
  font-weight: 600;
  color: #1D2129;
}

.categorySub {
  font-size: 22rpx;
  color: #86909C;
  margin-top: 4rpx;
}

.categoryActions {
  display: flex;
}

.editBudgetBtn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F7F9F8;
  border-radius: 50%;
  transition: all 0.2s ease;
}

.editBudgetBtnHover {
  background: #E8F3EE;
  transform: scale(0.9);
}

.editBudgetIcon {
  font-size: 28rpx;
}

/* 分类进度条 */
.categoryProgressBar {
  height: 12rpx;
  background: #F0F2F1;
  border-radius: 6rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
}

.categoryProgressFill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.5s ease;
}

/* 分类底部信息 */
.categoryFooter {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.categoryAmount {
  display: flex;
  align-items: center;
}

.amountUsed {
  font-size: 26rpx;
  color: #4E5969;
  font-weight: 500;
}

.amountDivider {
  margin: 0 8rpx;
  color: #C9CDD4;
}

.amountBudget {
  font-size: 24rpx;
  color: #86909C;
}

.percentageText {
  font-size: 28rpx;
  font-weight: 700;
  color: #7EB8A0;
}

.percentageOver {
  color: #EA2027;
}

.percentageWarning {
  color: #F39C12;
}

.categoryRemaining {
  padding-top: 12rpx;
  border-top: 1rpx solid #F7F9F8;
}

.remainingText {
  font-size: 24rpx;
  color: #7EB8A0;
}

.remainingOver {
  color: #EA2027;
  font-weight: 500;
}

.categoryUnconfigured {
  padding-top: 12rpx;
  border-top: 1rpx solid #F7F9F8;
}

.unconfiguredText {
  font-size: 24rpx;
  color: #C9CDD4;
}

/* 空状态 */
.emptyState {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 128rpx 32rpx;
}

.emptyIcon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.emptyTitle {
  font-size: 32rpx;
  font-weight: 600;
  color: #1D2129;
  margin-bottom: 12rpx;
}

.emptyDesc {
  font-size: 26rpx;
  color: #86909C;
  margin-bottom: 32rpx;
}

.emptyBtn {
  padding: 20rpx 48rpx;
  background: linear-gradient(135deg, #7EB8A0 0%, #A5D4BE 100%);
  border-radius: 40rpx;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 500;
  box-shadow: 0 8rpx 24rpx rgba(126, 184, 160, 0.3);
  transition: all 0.25s ease;
}

.emptyBtnHover {
  transform: scale(0.96);
}

/* 弹窗样式 */
.modalMask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modalContent {
  width: 640rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
}

.modalHeader {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid #F0F2F1;
}

.modalTitle {
  font-size: 32rpx;
  font-weight: 600;
  color: #1D2129;
}

.modalClose {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #86909C;
  border-radius: 50%;
  transition: all 0.2s ease;
}

.modalCloseHover {
  background: #F0F2F1;
}

.modalBody {
  padding: 32rpx;
}

.inputRow {
  margin-bottom: 24rpx;
}

.inputLabel {
  font-size: 28rpx;
  color: #4E5969;
  margin-bottom: 16rpx;
  display: block;
}

.inputWrapper {
  display: flex;
  align-items: center;
  background: #F7F9F8;
  border-radius: 12rpx;
  padding: 0 24rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.inputWrapper:focus-within {
  border-color: #7EB8A0;
  background: #FFFFFF;
}

.inputPrefix {
  font-size: 32rpx;
  color: #4E5969;
  margin-right: 12rpx;
  font-weight: 500;
}

.budgetInput {
  flex: 1;
  height: 80rpx;
  font-size: 32rpx;
  color: #1D2129;
}

.quickAmounts {
  display: flex;
  gap: 16rpx;
}

.quickAmountBtn {
  flex: 1;
  padding: 16rpx 0;
  background: #F7F9F8;
  border-radius: 12rpx;
  text-align: center;
  font-size: 26rpx;
  color: #4E5969;
  transition: all 0.2s ease;
}

.quickAmountBtnHover {
  background: #E8F3EE;
  color: #7EB8A0;
  transform: scale(0.95);
}

.categoryPreview {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #F7F9F8;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.previewIcon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  font-size: 36rpx;
}

.previewInfo {
  display: flex;
  flex-direction: column;
}

.previewName {
  font-size: 30rpx;
  font-weight: 600;
  color: #1D2129;
}

.previewUsed {
  font-size: 24rpx;
  color: #FF9F43;
  margin-top: 4rpx;
}

.modalFooter {
  display: flex;
  border-top: 1rpx solid #F0F2F1;
}

.modalBtn {
  flex: 1;
  padding: 32rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
  transition: all 0.2s ease;
}

.modalBtnCancel {
  color: #86909C;
  border-right: 1rpx solid #F0F2F1;
}

.modalBtnConfirm {
  color: #7EB8A0;
}

.modalBtnHover {
  background: #F7F9F8;
}
