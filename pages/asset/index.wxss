/* pages/asset/index.wxss */

.assetPage {
  min-height: 100vh;
  background: linear-gradient(180deg, #E8F3EE 0%, #F7F9F8 200rpx);
  padding-bottom: 120rpx;
}

/* 总资产卡片 */
.totalCard {
  margin: 32rpx;
  background: linear-gradient(135deg, #7EB8A0 0%, #5A9B82 100%);
  border-radius: 24rpx;
  padding: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(126, 184, 160, 0.3);
}

.totalLabel {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-bottom: 16rpx;
}

.totalAmount {
  font-size: 56rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 48rpx;
  letter-spacing: 2rpx;
}

.totalRow {
  display: flex;
  gap: 64rpx;
  padding-top: 48rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
}

.totalItem {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.totalItemLabel {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
}

.totalItemValue {
  font-size: 34rpx;
  font-weight: 600;
  color: #FFFFFF;
}

/* 快捷操作 */
.assetActions {
  display: flex;
  gap: 24rpx;
  margin: 32rpx;
}

.actionCard {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: all 0.15s ease;
}

.actionCard:active {
  transform: scale(0.96);
  opacity: 0.8;
}

.actionIcon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 16rpx;
  background: #E8F3EE;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-bottom: 16rpx;
}

.actionText {
  font-size: 24rpx;
  color: #4E5969;
}

/* 资产列表 */
.assetListSection {
  margin: 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 48rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.sectionHeader {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.sectionTitle {
  font-size: 30rpx;
  font-weight: 600;
  color: #1D2129;
}

.sectionAction {
  font-size: 24rpx;
  color: #7EB8A0;
  transition: all 0.15s ease;
}

.sectionAction:active {
  opacity: 0.7;
}

.assetItem {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F2F3F5;
  transition: all 0.15s ease;
}

.assetItem:last-child {
  border-bottom: none;
}

.assetItem:active {
  background: #F0F2F1;
  margin: 0 -48rpx;
  padding: 24rpx 48rpx;
}

.assetIcon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 16rpx;
  background: #E8F3EE;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 32rpx;
  flex-shrink: 0;
}

.assetInfo {
  flex: 1;
}

.assetName {
  font-size: 28rpx;
  font-weight: 500;
  color: #1D2129;
  margin-bottom: 4rpx;
  display: block;
}

.assetChange {
  font-size: 24rpx;
}

.assetChangePositive {
  color: #7EB8A0;
}

.assetChangeNegative {
  color: #FF4D4F;
}

.assetRight {
  text-align: right;
  flex-shrink: 0;
}

.assetAmount {
  font-size: 30rpx;
  font-weight: 600;
  color: #1D2129;
  margin-bottom: 4rpx;
  display: block;
}

.assetPercent {
  font-size: 24rpx;
}

.assetPercentPositive {
  color: #7EB8A0;
}

.assetPercentNegative {
  color: #FF4D4F;
}
