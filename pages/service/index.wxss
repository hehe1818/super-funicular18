/* pages/service/index.wxss */

.servicePage {
  min-height: 100vh;
  background: #F7F9F8;
  padding: 32rpx;
}

.placeholderContent {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 256rpx 32rpx;
}

.placeholderIcon {
  font-size: 100rpx;
  margin-bottom: 48rpx;
}

.placeholderTitle {
  font-size: 34rpx;
  font-weight: 600;
  color: #1D2129;
  margin-bottom: 24rpx;
}

.placeholderDesc {
  font-size: 28rpx;
  color: #86909C;
}

.contactInfo {
  margin-top: 48rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 48rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.contactItem {
  display: flex;
  align-items: center;
  gap: 32rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F2F3F5;
}

.contactItem:last-child {
  border-bottom: none;
}

.contactLabel {
  font-size: 24rpx;
  color: #86909C;
  width: 160rpx;
}

.contactValue {
  font-size: 28rpx;
  color: #1D2129;
}
