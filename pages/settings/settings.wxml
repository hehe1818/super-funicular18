<!--settings.wxml-->
<view class="page">
  <!-- 自定义顶部标题栏 -->
  <view class="custom-nav">
    <view class="nav-content">
      <text class="nav-icon">⚙️</text>
      <text class="nav-title">设置</text>
    </view>
  </view>

  <scroll-view class="scrollarea" scroll-y show-scrollbar="{{false}}">
    <view class="container">
      
      <!-- 用户信息卡片 -->
      <view class="user-card" bindtap="viewUserDetail">
        <block wx:if="{{isLoggedIn}}">
          <image class="user-avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
          <view class="user-detail">
            <text class="user-nickname">{{userInfo.nickName || '微信用户'}}</text>
            <view class="user-status">
              <text class="status-dot online"></text>
              <text class="status-text">已登录</text>
            </view>
          </view>
          <view class="arrow">›</view>
        </block>
        <block wx:else>
          <view class="default-avatar">
            <text class="avatar-icon">👤</text>
          </view>
          <view class="user-detail">
            <text class="user-nickname">点击登录</text>
            <view class="user-status">
              <text class="status-dot offline"></text>
              <text class="status-text">未登录</text>
            </view>
          </view>
          <view class="arrow">›</view>
        </block>
      </view>

      <!-- 用户信息详情（仅登录时显示） -->
      <view class="info-section" wx:if="{{isLoggedIn}}">
        <view class="section-title">账户信息</view>
        
        <view class="info-item" bindtap="copyOpenId">
          <text class="item-label">OpenID</text>
          <view class="item-value-wrapper">
            <text class="item-value">{{userInfo.openid}}</text>
            <text class="copy-icon">📋</text>
          </view>
        </view>
        
        <view class="info-item">
          <text class="item-label">登录时间</text>
          <text class="item-value">{{loginTime}}</text>
        </view>
        
        <view class="info-item">
          <text class="item-label">登录状态</text>
          <text class="item-value status-online">● 在线</text>
        </view>
      </view>

      <!-- 设置选项 -->
      <view class="settings-section">
        <view class="section-title">通用设置</view>
        
        <view class="settings-item" bindtap="clearCache">
          <view class="item-left">
            <text class="item-icon">🗑️</text>
            <text class="item-text">清除缓存</text>
          </view>
          <view class="item-right">
            <text class="arrow-icon">›</text>
          </view>
        </view>
        
        <view class="settings-item" bindtap="showFeedback">
          <view class="item-left">
            <text class="item-icon">💬</text>
            <text class="item-text">意见反馈</text>
          </view>
          <view class="item-right">
            <text class="arrow-icon">›</text>
          </view>
        </view>
        
        <view class="settings-item" bindtap="showAbout">
          <view class="item-left">
            <text class="item-icon">ℹ️</text>
            <text class="item-text">关于我们</text>
          </view>
          <view class="item-right">
            <text class="version">v{{version}}</text>
            <text class="arrow-icon">›</text>
          </view>
        </view>
      </view>

      <!-- 退出登录按钮 -->
      <view class="logout-section" wx:if="{{isLoggedIn}}">
        <view class="logout-btn" bindtap="onLogout">
          <text class="logout-btn-text">退出登录</text>
        </view>
      </view>

      <!-- 登录按钮（未登录时显示） -->
      <view class="login-section" wx:else>
        <view class="login-btn" bindtap="goToLogin">
          <text class="login-btn-text">立即登录</text>
        </view>
      </view>

      <!-- 底部版权 -->
      <view class="footer">
        <text class="copyright">© 2024 随机抽取工具</text>
      </view>

      <!-- 底部占位 -->
      <view class="bottom-space"></view>
    </view>
  </scroll-view>
</view>
