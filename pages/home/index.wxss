/* pages/home/index.wxss */

.homePage {
  min-height: 100vh;
  background: linear-gradient(180deg, #E8F3EE 0%, #F7F9F8 300rpx);
  padding-bottom: 120rpx;
}

/* 头部 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 48rpx 32rpx;
  background: linear-gradient(135deg, #7EB8A0 0%, #5A9B82 100%);
  padding-top: calc(env(safe-area-inset-top) + 48rpx);
  padding-bottom: 48rpx;
}

.headerTitle {
  font-size: 40rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.headerActions {
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.headerIcon {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 36rpx;
  transition: all 0.15s ease;
}

.headerIcon:active {
  transform: scale(0.92);
  opacity: 0.85;
}

.headerIconHover {
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
}

.headerIconRefreshing {
  animation: rotate 0.8s linear infinite;
}

@keyframes rotate {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

/* 结余卡片 */
.balanceCard {
  margin: -32rpx 32rpx 0;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 48rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  position: relative;
  overflow: hidden;
}

.balanceCard::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, #7EB8A0, #A5D4BE);
}

.balanceLabel {
  font-size: 24rpx;
  color: #86909C;
  margin-bottom: 16rpx;
}

.balanceAmount {
  font-size: 56rpx;
  font-weight: 700;
  color: #1D2129;
  margin-bottom: 48rpx;
  letter-spacing: 2rpx;
}

.balanceAmountNegative {
  color: #FF4D4F;
}

.incomeExpenseRow {
  display: flex;
  gap: 64rpx;
}

.incomeExpenseItem {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.incomeLabel,
.expenseLabel {
  font-size: 22rpx;
  color: #86909C;
}

.incomeAmount {
  font-size: 34rpx;
  font-weight: 600;
  color: #7EB8A0;
}

.expenseAmount {
  font-size: 34rpx;
  font-weight: 600;
  color: #FF9F43;
}

/* 时间筛选 */
.timeFilter {
  display: flex;
  margin: 32rpx;
  background: #FFFFFF;
  border-radius: 48rpx;
  padding: 8rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.timeFilterItem {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #4E5969;
  border-radius: 48rpx;
  transition: all 0.25s ease;
}

.timeFilterItem:active {
  transform: scale(0.96);
}

.timeFilterItemActive {
  background: linear-gradient(135deg, #7EB8A0 0%, #5A9B82 100%);
  color: #FFFFFF;
  font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(126, 184, 160, 0.4);
}

.timeFilterItemHover {
  background: #F0F2F1;
}

/* 快捷操作 */
.quickActions {
  display: flex;
  justify-content: space-around;
  margin: 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.quickActionItem {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx;
  transition: all 0.15s ease;
}

.quickActionItem:active {
  transform: scale(0.92);
  opacity: 0.8;
}

.quickActionItemHover {
  background: #F0F2F1;
  border-radius: 24rpx;
}

.quickActionIcon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 32rpx;
  background: #E8F3EE;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  transition: all 0.25s ease;
}

.quickActionText {
  font-size: 24rpx;
  color: #4E5969;
}

/* 分区标题 */
.sectionHeader {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 48rpx 32rpx 16rpx;
}

.sectionTitle {
  font-size: 30rpx;
  font-weight: 600;
  color: #1D2129;
}

.sectionMore {
  font-size: 24rpx;
  color: #86909C;
  display: flex;
  align-items: center;
  gap: 4rpx;
  transition: all 0.15s ease;
}

.sectionMore:active {
  opacity: 0.7;
}

/* 交易列表 */
.transactionList {
  margin: 0 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.transactionItem {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #F2F3F5;
  transition: all 0.15s ease;
}

.transactionItem:last-child {
  border-bottom: none;
}

.transactionItem:active {
  background: #F0F2F1;
}

.transactionIcon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 16rpx;
  background: #E8F3EE;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 32rpx;
  flex-shrink: 0;
}

.transactionInfo {
  flex: 1;
  min-width: 0;
}

.transactionCategory {
  font-size: 28rpx;
  font-weight: 500;
  color: #1D2129;
  margin-bottom: 4rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.transactionNote {
  font-size: 24rpx;
  color: #86909C;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.transactionRight {
  text-align: right;
  flex-shrink: 0;
}

.transactionAmountExpense {
  font-size: 30rpx;
  font-weight: 600;
  color: #FF9F43;
}

.transactionAmountIncome {
  font-size: 30rpx;
  font-weight: 600;
  color: #7EB8A0;
}

.transactionDate {
  font-size: 22rpx;
  color: #C9CDD4;
  margin-top: 4rpx;
}

/* 空状态 */
.emptyState {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 128rpx 32rpx;
}

.emptyIcon {
  font-size: 80rpx;
  margin-bottom: 32rpx;
}

.emptyText {
  font-size: 28rpx;
  color: #86909C;
}
