/* login.wxss */

page {
  height: 100vh;
  background: #f5f7fa;
}

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f7fa;
}

/* ============ 自定义顶部标题栏 ============ */
.custom-nav {
  width: 100%;
  height: calc(88rpx + env(safe-area-inset-top));
  padding-top: env(safe-area-inset-top);
  background: #fff;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  flex-shrink: 0;
}

.nav-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.login-container {
  flex: 1;
  padding: 40rpx 40rpx 100rpx;
  min-height: 0;
  overflow-y: auto;
}

.login-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
}

.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.logo-wrapper {
  width: 200rpx;
  height: 200rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  box-shadow: 0 16rpx 48rpx rgba(102, 126, 234, 0.35);
}

.logo-icon {
  font-size: 96rpx;
}

.app-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.app-desc {
  font-size: 26rpx;
  color: #999;
}

.login-form {
  width: 100%;
  display: flex;
  flex-direction: column;
  margin-top: 20rpx;
}

.login-btn {
  width: 100%;
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  border-radius: 56rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border: none;
  box-shadow: 0 12rpx 40rpx rgba(102, 126, 234, 0.35);
  margin-bottom: 30rpx;
  transition: all 0.2s ease;
}

.login-btn:active {
  transform: scale(0.98);
}

.login-btn.loading {
  opacity: 0.7;
}

.login-btn-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.login-btn-text {
  font-size: 34rpx;
  font-weight: bold;
  color: #fff;
}

.profile-btn {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  border-radius: 48rpx;
  background: #fff;
  border: 2rpx solid #e0e0e0;
  color: #666;
}

.profile-btn:active {
  background: #f5f5f5;
}

.profile-btn-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.profile-btn-text {
  font-size: 30rpx;
  color: #666;
}

.tips {
  margin-top: 60rpx;
  display: flex;
  align-items: center;
}

.tips-icon {
  font-size: 26rpx;
  margin-right: 10rpx;
}

.tips-text {
  color: #999;
  font-size: 26rpx;
}

/* 已登录状态 */
.logged-content {
  padding-top: 40rpx;
}

.user-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx 32rpx;
  border-radius: 32rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 12rpx 40rpx rgba(102, 126, 234, 0.3);
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 30rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  background: rgba(255, 255, 255, 0.2);
}

.user-info {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.nickname {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 14rpx;
}

.status-tag {
  display: inline-flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.2);
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  width: fit-content;
}

.status-tag .status-dot {
  width: 12rpx;
  height: 12rpx;
  background: #4ade80;
  border-radius: 50%;
  margin-right: 8rpx;
}

.status-tag .status-label {
  font-size: 22rpx;
  color: #fff;
}

.login-info {
  background: #fff;
  padding: 20rpx 32rpx;
  border-radius: 32rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 4rpx 24rpx rgba(102, 126, 234, 0.08);
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #666;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  font-family: monospace;
}

.info-value.success {
  color: #4ade80;
}

.logout-btn {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  border-radius: 48rpx;
  background: #fff;
  border: 2rpx solid #ff6b6b;
  box-sizing: border-box;
}

.logout-btn:active {
  background-color: #fff5f5;
}

.logout-btn-text {
  font-size: 32rpx;
  color: #ff6b6b;
  font-weight: 500;
}
