<!--index.wxml-->
<view class="page">
  <!-- 自定义顶部标题栏 -->
  <view class="custom-nav">
    <view class="nav-content">
      <text class="nav-icon">🎲</text>
      <text class="nav-title">随机抽取</text>
    </view>
  </view>

  <scroll-view class="scrollarea" scroll-y show-scrollbar="{{false}}">
    <view class="container">
      
      <!-- 未登录状态 -->
      <block wx:if="{{!isLoggedIn}}">
        <view class="login-prompt">
          <view class="prompt-icon-wrapper">
            <text class="prompt-icon">🔐</text>
          </view>
          <text class="prompt-title">请先登录</text>
          <text class="prompt-desc">登录后即可使用随机抽取功能</text>
          <button class="login-btn" type="primary" bindtap="goToLogin">
            立即登录
          </button>
        </view>
      </block>

      <!-- 已登录状态 -->
      <block wx:else>
        
        <!-- 用户状态卡片 -->
        <view class="user-card">
          <view class="avatar-wrapper">
            <image class="user-avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
            <view class="status-badge">
              <text class="status-dot"></text>
            </view>
          </view>
          <view class="user-info">
            <text class="user-greeting">你好，</text>
            <text class="user-nickname">{{userInfo.nickName || '微信用户'}}</text>
            <view class="login-status-tag">
              <text class="status-dot-small"></text>
              <text class="status-text">已登录</text>
            </view>
          </view>
        </view>

        <!-- 数据输入卡片 -->
        <view class="card input-card">
          <view class="card-header">
            <view class="card-title-row">
              <text class="card-title-icon">📝</text>
              <text class="card-title">数据输入</text>
            </view>
            <text class="card-count">共 {{itemCount}} 条</text>
          </view>

          <!-- 单条输入模式 -->
          <view wx:if="{{!showBatchInput}}" class="input-wrapper">
            <view class="input-icon-wrapper">
              <text class="input-icon">➕</text>
            </view>
            <input 
              class="text-input" 
              placeholder="输入姓名，如：张三" 
              placeholder-class="input-placeholder"
              value="{{inputValue}}"
              bindinput="onInputChange"
              confirm-type="done"
              bindconfirm="addSingleItem"
            />
            <view 
              class="add-btn {{!inputValue ? 'disabled' : ''}}"
              bindtap="addSingleItem"
            >
              <text class="add-btn-text">添加</text>
            </view>
          </view>

          <!-- 批量输入模式 -->
          <view wx:else class="batch-wrapper">
            <view class="batch-icon-wrapper">
              <text class="batch-icon">📋</text>
            </view>
            <textarea 
              class="batch-textarea" 
              placeholder="每行一条数据&#10;如：&#10;张三&#10;李四&#10;王五"
              placeholder-class="input-placeholder"
              value="{{batchText}}"
              bindinput="onBatchInputChange"
              auto-height
              maxlength="-1"
            ></textarea>
            <view 
              class="batch-add-btn {{!batchText ? 'disabled' : ''}}"
              bindtap="addBatchItems"
            >
              <text class="batch-add-text">批量添加</text>
            </view>
          </view>

          <!-- 模式切换胶囊按钮 -->
          <view class="mode-switch">
            <view 
              class="mode-btn {{!showBatchInput ? 'active' : ''}}"
              bindtap="toggleBatchInput"
            >
              <text class="mode-icon">✏️</text>
              <text class="mode-text">单条</text>
            </view>
            <view 
              class="mode-btn {{showBatchInput ? 'active' : ''}}"
              bindtap="toggleBatchInput"
            >
              <text class="mode-icon">📋</text>
              <text class="mode-text">批量</text>
            </view>
          </view>
        </view>

        <!-- 数据列表卡片 -->
        <view class="card list-card" wx:if="{{items.length > 0}}">
          <view class="card-header">
            <view class="card-title-row">
              <text class="card-title-icon">📋</text>
              <text class="card-title">数据列表</text>
            </view>
            <view class="clear-btn" bindtap="clearAllItems">
              <text class="clear-icon">🗑️</text>
              <text class="clear-text">清空</text>
            </view>
          </view>

          <scroll-view class="items-scroll" scroll-y show-scrollbar="{{false}}">
            <view class="items-list">
              <view 
                class="item-row" 
                wx:for="{{items}}" 
                wx:key="id"
              >
                <view class="item-index">{{index + 1}}</view>
                <text class="item-value">{{item.value}}</text>
                <view 
                  class="item-delete" 
                  bindtap="deleteItem" 
                  data-id="{{item.id}}"
                >
                  <text class="delete-icon">✕</text>
                </view>
              </view>
            </view>
          </scroll-view>
        </view>

        <!-- 空状态 -->
        <view class="card empty-card" wx:if="{{items.length === 0}}">
          <view class="empty-illustration">
            <text class="empty-icon">📭</text>
            <view class="empty-dots">
              <view class="dot"></view>
              <view class="dot"></view>
              <view class="dot"></view>
            </view>
          </view>
          <text class="empty-title">暂无数据</text>
          <text class="empty-desc">点击上方添加，开始您的抽奖之旅</text>
        </view>

        <!-- 抽取设置卡片 -->
        <view class="card draw-settings-card" wx:if="{{items.length > 0}}">
          <view class="card-header">
            <view class="card-title-row">
              <text class="card-title-icon">🎯</text>
              <text class="card-title">抽取设置</text>
            </view>
          </view>

          <view class="settings-row">
            <text class="settings-label">抽取数量</text>
            
            <!-- 预设选择 -->
            <view wx:if="{{!showCustomCount}}" class="count-picker-wrapper">
              <picker 
                class="count-picker"
                range="{{drawCountOptions}}"
                value="{{drawCountIndex}}"
                bindchange="onDrawCountChange"
              >
                <view class="picker-display">
                  <text class="picker-value">{{drawCount}}</text>
                  <text class="picker-arrow">▼</text>
                </view>
              </picker>
              <view class="custom-count-btn" bindtap="showCustomCountInput">
                <text class="custom-count-text">自定义</text>
              </view>
            </view>

            <!-- 自定义输入 -->
            <view wx:else class="custom-count-wrapper">
              <input 
                class="custom-count-input" 
                type="number"
                value="{{customCount}}"
                bindinput="onCustomCountInput"
                placeholder="输入数量"
                placeholder-class="input-placeholder"
              />
              <view class="confirm-btn" bindtap="confirmCustomCount">
                <text class="confirm-text">确定</text>
              </view>
              <view class="cancel-btn" bindtap="hideCustomCountInput">
                <text class="cancel-text">取消</text>
              </view>
            </view>
          </view>

          <view class="settings-tip">
            <text class="tip-icon">💡</text>
            <text class="tip-text">最多可抽取 {{items.length}} 条</text>
          </view>
        </view>

        <!-- 开始抽取主按钮 -->
        <view class="draw-button-wrapper" wx:if="{{items.length > 0}}">
          <view 
            class="draw-button {{isDrawing ? 'drawing' : ''}}"
            bindtap="doDraw"
          >
            <text class="draw-button-icon">{{isDrawing ? '🎰' : '🎲'}}</text>
            <text class="draw-button-text">{{isDrawing ? '抽取中...' : '开始抽取'}}</text>
          </view>
        </view>

        <!-- 抽取结果 -->
        <view class="card result-card" wx:if="{{hasDrawn}}">
          <view class="card-header">
            <view class="card-title-row">
              <text class="card-title-icon">✨</text>
              <text class="card-title">抽取结果</text>
            </view>
            <view class="result-badge">
              <text class="result-badge-text">共 {{drawResult.length}} 条</text>
            </view>
          </view>

          <view class="result-list">
            <view 
              class="result-item" 
              wx:for="{{drawResult}}" 
              wx:key="id"
            >
              <view class="result-number">
                <text class="number-text">{{index + 1}}</text>
              </view>
              <text class="result-text">{{item.value}}</text>
              <view class="result-badge-icon">
                <text class="badge-icon">🎉</text>
              </view>
            </view>
          </view>

          <view class="result-actions">
            <view class="action-btn primary" bindtap="redraw">
              <text class="action-icon">🔄</text>
              <text class="action-text">再抽一次</text>
            </view>
            <view class="action-btn secondary" bindtap="resetResult">
              <text class="action-icon">🗑️</text>
              <text class="action-text">清除结果</text>
            </view>
          </view>
        </view>

        <!-- 底部占位 -->
        <view class="bottom-placeholder"></view>
      </block>
    </view>
  </scroll-view>
</view>
