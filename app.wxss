/**app.wxss**/

page {
  background-color: #F7F9F8;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  color: #1D2129;
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

view, text {
  box-sizing: border-box;
}

button {
  background: initial;
}

button:focus {
  outline: 0;
}

button::after {
  border: none;
}

.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}
